// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  INDIVIDUAL
  BUSINESS
  COLLECTOR
  RECYCLER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("INDIVIDUAL") // using String instead of enum because SQLite doesn't support enums natively
  phone         String?
  city          String?
  state         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  pickupRequests PickupRequest[]
  collectorAssignments PickupAssignment[]
  ecoPoints     EcoPointTransaction[]
  certificates  Certificate[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WasteCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  basePoints  Int      @default(0) // Points per kg
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       PickupItem[]
}

model PickupRequest {
  id            String   @id @default(cuid())
  userId        String
  pickupId      String   @unique // ECO-2026-000001
  status        String   @default("REQUESTED") // REQUESTED, CONFIRMED, ASSIGNED, IN_PROGRESS, COLLECTED, SORTED, RECEIVED, RECYCLING, COMPLETED
  address       String
  scheduledDate DateTime
  scheduledTime String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  items         PickupItem[]
  assignment    PickupAssignment?
  batch         CollectionBatch?
  events        TrackingEvent[]
}

model PickupItem {
  id              String   @id @default(cuid())
  pickupRequestId String
  categoryId      String
  quantity        Int
  estimatedWeight Float
  images          String // Comma separated URLs

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  category        WasteCategory @relation(fields: [categoryId], references: [id])
}

model PickupAssignment {
  id              String   @id @default(cuid())
  pickupRequestId String   @unique
  collectorId     String
  assignedAt      DateTime @default(now())
  status          String   @default("PENDING") // PENDING, ACCEPTED, EN_ROUTE, ARRIVED, COMPLETED, CANCELLED
  actualWeight    Float?

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id])
  collector       User          @relation(fields: [collectorId], references: [id])
}

model CollectionBatch {
  id              String   @id @default(cuid())
  pickupRequestId String   @unique
  batchId         String   @unique // BATCH-2026-001
  qrCode          String   @unique
  status          String   @default("COLLECTED")
  currentLocation String?
  recyclerId      String?
  verifiedWeight  Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id])
  certificate     Certificate?
}

model TrackingEvent {
  id              String   @id @default(cuid())
  pickupRequestId String
  status          String
  location        String?
  notes           String?
  timestamp       DateTime @default(now())

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id])
}

model Certificate {
  id              String   @id @default(cuid())
  batchId         String   @unique
  userId          String
  certificateId   String   @unique // CERT-2026-001
  issueDate       DateTime @default(now())
  documentUrl     String?

  batch           CollectionBatch @relation(fields: [batchId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
}

model EcoPointTransaction {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  type        String   @default("EARNED") // EARNED, REDEEMED
  description String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
