// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// User role (Using String since SQLite doesn't natively support enum)
// CUSTOMER, COLLECTOR, RECYCLER, ADMIN
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("CUSTOMER") 
  phone         String?
  city          String?
  state         String?
  serviceArea   String?   // For collectors
  companyName   String?   // For recyclers
  accountStatus String    @default("ACTIVE") // ACTIVE, PENDING, DISABLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  pickupRequests PickupRequest[]
  collectorAssignments PickupAssignment[]
  ecoPoints     EcoPointTransaction[]
  certificates  Certificate[]
  notifications Notification[]
  batches       CollectionBatch[] @relation("RecyclerBatches") // Batches assigned to recycler
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WasteCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  basePoints  Int      @default(0) // Points per kg
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       PickupItem[]
  batches     CollectionBatch[]
}

model PickupRequest {
  id               String   @id @default(cuid())
  userId           String
  pickupId         String   @unique // ECO-PICK-000001
  status           String   @default("PICKUP_REQUESTED")
  address          String
  city             String?
  state            String?
  pincode          String?
  scheduledDate    DateTime?
  scheduledTime    String?
  customerPrefDate DateTime?
  customerPrefTime String?
  additionalNotes  String?
  verificationCode String?  // 6-digit code for collection
  collectionNotes  String?
  collectionImage  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  items         PickupItem[]
  assignment    PickupAssignment?
  batch         CollectionBatch?
  events        TrackingEvent[]
}

model PickupItem {
  id              String   @id @default(cuid())
  pickupRequestId String
  categoryId      String
  quantity        Int
  estimatedWeight Float
  deviceType      String?
  condition       String?
  images          String // Comma separated URLs

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  category        WasteCategory @relation(fields: [categoryId], references: [id])
}

model PickupAssignment {
  id              String   @id @default(cuid())
  pickupRequestId String   @unique
  collectorId     String
  assignedAt      DateTime @default(now())
  status          String   @default("PICKUP_ACCEPTED") // PICKUP_ACCEPTED, COLLECTOR_ON_THE_WAY, COLLECTOR_ARRIVED, COLLECTED
  actualWeight    Float?
  actualQuantity  Int?

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id])
  collector       User          @relation(fields: [collectorId], references: [id])
}

model CollectionBatch {
  id              String   @id @default(cuid())
  pickupRequestId String   @unique
  batchId         String   @unique // ECO-BATCH-000001
  qrCode          String?  @unique
  status          String   @default("AT_COLLECTION_CENTER") // SENT_TO_RECYCLER, RECYCLER_RECEIVED, RECYCLING_IN_PROGRESS, RECYCLED, COMPLETED
  currentLocation String?
  recyclerId      String?
  categoryId      String?
  actualWeight    Float?
  verifiedWeight  Float?
  collectionDate  DateTime?
  dispatchDate    DateTime?
  receivedDate    DateTime?
  completionDate  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id])
  recycler        User?         @relation("RecyclerBatches", fields: [recyclerId], references: [id])
  category        WasteCategory? @relation(fields: [categoryId], references: [id])
  certificate     Certificate?
  recyclingRecord RecyclingRecord?
  materials       RecoveredMaterial[]
}

model RecyclingRecord {
  id               String   @id @default(cuid())
  batchId          String   @unique
  processingDate   DateTime @default(now())
  processingMethod String?
  notes            String?

  batch            CollectionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model RecoveredMaterial {
  id              String   @id @default(cuid())
  batchId         String
  materialName    String
  recoveredWeight Float
  unit            String   @default("kg")
  notes           String?

  batch           CollectionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model TrackingEvent {
  id              String   @id @default(cuid())
  pickupRequestId String
  status          String
  location        String?
  notes           String?
  responsibleRole String?
  timestamp       DateTime @default(now())

  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                    String   @id @default(cuid())
  batchId               String   @unique
  userId                String
  certificateId         String   @unique // ECO-CERT-000001
  issueDate             DateTime @default(now())
  documentUrl           String?
  wasteCategory         String?
  collectedWeight       Float?
  verifiedRecycledWeight Float?

  batch           CollectionBatch @relation(fields: [batchId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
}

model EcoPointTransaction {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  type        String   @default("EARNED") // EARNED, REDEEMED
  description String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  message     String
  type        String   @default("INFO")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
